# engine_loop/config.env — engine loop 的單一環境錨點（PLAN §3）
#
# 用法：
#   set -a; source agent_harness/engine_loop/config.env; set +a
#   或由 runners/*.sh 與 wrappers/*.sh 自動 source（它們從自己的位置往上找）。
#
# 設計規則（三條，都有原因）：
#
# 1. **自我錨定**：所有路徑從 `${BASH_SOURCE[0]}` 推導，不假設 CWD、不假設被誰 source。
#    這一條是有代價的教訓：`tb_loop/config.env` 在 E1 之前用 `$TB_LOOP_DIR/../app/...` 這種
#    「相對鄰居」的寫法，而鄰居在搬遷時換了 ⇒ 四條路徑靜默指錯。見 lesson `eng-smoke-0003`。
#
# 2. **不複製生產腳本的路徑規則**：`scripts/run_server.sh` 與 `scripts/check/*` 是生產腳本
#    （PLAN §3 紅線）。這裡只記錄**它們在哪**，不重述它們的預設值 —— 重述就是第二份真相，
#    而第二份真相的失效方式是安靜的（它還是能跑，只是跑的是舊規則）。
#    實例：`run_server.sh:153-162` 依 runtime profile 在三個 .gguf 之間選預設模型；
#    如果這裡再寫死一個「預設模型」，那兩個預設就會在某次改動後分岔。
#
# 3. **不猜判斷**：任何「選哪個模型／哪個 profile」都是實驗設計的一部分，不是環境常數。
#    所以那些一律留空，由呼叫者顯式給；空的語意是「交給權威決定」，不是「用某個隱藏預設」。
#    （`distill/refine_engine.sh` 的 `REFINE_ENGINE_MODEL` 是同一條立場。）

# ---- 錨點 -------------------------------------------------------------------
# 三個名字代表三件不同的事，刻意分開（`eng-smoke-0003`：一個變數若「恰好」等於另一個，
# 任何掛在它底下的派生都是定時炸彈）。
ENGINE_LOOP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"   # 這個目錄
ENGINE_HARNESS_ROOT="$(cd "$ENGINE_LOOP_DIR/.." && pwd)"          # agent_harness/
ENGINE_REPO_ROOT="$(cd "$ENGINE_HARNESS_ROOT/.." && pwd)"         # 倉庫根

# ---- 生產腳本的位置（唯讀引用，永不複製）-------------------------------------
ENGINE_SCRIPTS_DIR="$ENGINE_REPO_ROOT/scripts"
ENGINE_CHECK_DIR="$ENGINE_SCRIPTS_DIR/check"
ENGINE_SERVER_SH="$ENGINE_SCRIPTS_DIR/run_server.sh"

# ---- 引擎本體 ---------------------------------------------------------------
ENGINE_BIN="${ENGINE_BIN:-$ENGINE_REPO_ROOT/src/llama.cpp/build/bin}"
ENGINE_SERVER="$ENGINE_BIN/llama-server"
ENGINE_MODEL_ROOT="${ENGINE_MODEL_ROOT:-$ENGINE_REPO_ROOT/models/gguf}"
# 空 = 交給 run_server.sh 決定（它是權威）。要覆寫就 export 一個明確的值。
ENGINE_MODEL="${ENGINE_MODEL:-}"

# `run_server.sh` 的 SERVER_PROFILE 合法值（抽自它自己的 case 分支，不是抄的）。
# 留成「參考」而非「驗證來源」：`runners/server.sh` 會在執行時**重新從 run_server.sh 讀一次**，
# 所以它改了這裡不會靜默過期。
ENGINE_PROFILE="${ENGINE_PROFILE:-}"          # 空 = run_server.sh 的預設（off）
ENGINE_RUNTIME_PROFILE="${ENGINE_RUNTIME_PROFILE:-}"   # auto|mtp|non-mtp，空 = auto

# 推論所需的 context。**這不是可選的旋鈕**：closed_loop.py 的四臂 prompt 是 ~30.6k tokens
# （2026-09-17 `/tokenize` 實測），而 run_server.sh 的預設 ctx（4096/8192）裝不下 ⇒ 請求會
# 被截斷而回答仍然「看起來像回事」。設成 0 代表「不檢查」。
ENGINE_MIN_CTX="${ENGINE_MIN_CTX:-40960}"

# ---- 指紋的權威 -------------------------------------------------------------
# build 指紋的唯一定義在 `scripts/check/decode_sweep.py:build_fingerprint()`。
# 這裡不重寫它，只記它在哪；`runners/rebuild.sh` 會 import 它來產 build.json。
# 為什麼不重寫：`ab_interleave.py:42-50` 已經因為自己抄了一份而有過一次漂移（漏了
# libggml-base ⇒ 兩次 scheduler 不同的 run 被蓋上同一個可比較指紋）。見 lesson `eng-mh-0007`。
ENGINE_FP_MODULE="$ENGINE_CHECK_DIR/decode_sweep.py"

# ---- 產物 -------------------------------------------------------------------
# 單一出口（PLAN §3）：訓練數據只有一個門。traces/ 底下的東西是產出物本體，納管。
ENGINE_TRACES_DIR="$ENGINE_LOOP_DIR/traces"
# 證據 pack 的家。§8 的「< 20 MB」上界只有在產物進版控時才有意義 ⇒ 這一格是納管的。
EVIDENCE_ROOT="${EVIDENCE_ROOT:-$ENGINE_HARNESS_ROOT/shared/evidence}"

export ENGINE_LOOP_DIR ENGINE_HARNESS_ROOT ENGINE_REPO_ROOT
export ENGINE_SCRIPTS_DIR ENGINE_CHECK_DIR ENGINE_SERVER_SH
export ENGINE_BIN ENGINE_SERVER ENGINE_MODEL_ROOT ENGINE_MODEL
export ENGINE_PROFILE ENGINE_RUNTIME_PROFILE ENGINE_MIN_CTX
export ENGINE_FP_MODULE ENGINE_TRACES_DIR EVIDENCE_ROOT
