# ============================================================
# config.local.env —— 本機私密覆寫（★ 這個檔案本身不入版控）
#
# 用法:
#     cp agent_harness/tb_loop/config.local.env.example \
#        agent_harness/tb_loop/config.local.env
#     然後把 TB_GEMMA4_API_KEY 填進去。
#
# 載入時機：scripts/run_model_smoke.sh 在 source config.env **之後** 才載入本檔，
# 所以這裡的值會蓋掉版控內的預設（config.env 預設指向本機 llama.cpp 的
# host.docker.internal:1234）。run_round.sh 不會讀本檔 —— 學習循環那條路刻意
# 仍然只吃 config.env，避免「同一份資產在兩條路上跑不同模型」。
#
# 為什麼要分成兩個檔：config.env 在版控內，而且被 engine_loop 的 MANIFEST 索引
# （index_assets.py --check 會驗它的 bytes/mtime）⇒ 金鑰寫進去就會進 git 並讓索引漂移。
# 金鑰只放本檔，本檔由 .gitignore 排除。
# ============================================================

# ---- 端點：騰訊雲 TokenHub（OpenAI 相容）----
# Key 在 https://console.cloud.tencent.com/tokenhub/apikey 建。
# 建完要確認「可訪問範圍」有勾到你要用的模型 —— 沒勾到是 403，不是 401，
# 而兩者在容器裡都只長成「agent 第一個模型呼叫就失敗」。
TB_GEMMA4_BASE_URL="https://tokenhub.tencentmaas.com/v1"

# ★ 把 key 填在這裡。留空的話 run_model_smoke.sh 會直接 abort（而不是跑到容器裡才 401）。
TB_GEMMA4_API_KEY=""

# 真正送給端點的模型名（不是 -m 那個標籤）。hy3 = 混元 3。
TB_GEMMA4_MODEL="hy3"
