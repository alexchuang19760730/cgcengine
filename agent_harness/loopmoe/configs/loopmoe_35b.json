  "act_temperature": 1.0,

  "use_lti_constraint": true,
  "lti_rho_target_recurrent": 0.99,
  "lti_rho_target_delta": 0.95,
  "lti_weight_recurrent": 1.0,
  "lti_weight_delta": 0.5,
  "lti_warmup_steps": 1000,
  "delta_decay_max": 0.95,

  "graft_source_model": "Qwen/Qwen3.5-35B-A3B",
  "graft_deltanet_source_layer": 4,
  "graft_moe_source_layer": 4,

  "use_cache": true,
  "output_router_logits": true,
  "initializer_range": 0.02
