+            fprintf(stderr, "CGC-L4-EVICT-TRACE: tid=%llu layer=%u slot=%d evict_no=%llu %s\n",
+                    cgc_tid, layer, slot, cgc_n, cgc_new ? "[NEW THREAD]" : "");
+        }
+    }
