 static void cgc_discard_pool_slot(llama_expert_cache * cache, uint32_t layer, int32_t slot) {
+    // [CGC C-stage1 READ-ONLY] CGC_L4_EVICT_TRACE: record WHICH thread evicts a pool slot.
+    // Stage-2 cold-page return (MADV_FREE_REUSABLE on Metal pool_ext) is safe only when the
+    // victim is not on a GPU command buffer still in flight. Static reading shows pool_ext
+    // eviction happens only via pick_slot on the build thread (ensure_slot/ensure_batch, before
+    // graph_compute); the bg loop's evict_lru touches only the legacy malloc map, not pool_ext.
+    // This probe confirms it at runtime. Read-only, rate-limited, default OFF; it never changes
+    // the discard decision below.
+    if (getenv("CGC_L4_EVICT_TRACE") != nullptr) {
+        static std::mutex              cgc_tr_m;
+        static unsigned long long      cgc_tr_tid[16] = {0};
+        static unsigned long long      cgc_tr_cnt[16] = {0};
+        const unsigned long long cgc_tid = (unsigned long long)(uintptr_t) pthread_self();
+        unsigned long long cgc_n = 0;
+        bool cgc_new = false;
+        {
+            std::lock_guard<std::mutex> cgc_lk(cgc_tr_m);
+            int cgc_free = -1;
+            for (int cgc_i = 0; cgc_i < 16; ++cgc_i) {
+                if (cgc_tr_tid[cgc_i] == cgc_tid) { cgc_n = ++cgc_tr_cnt[cgc_i]; break; }
+                if (cgc_tr_tid[cgc_i] == 0 && cgc_free < 0) { cgc_free = cgc_i; }
+            }
+            if (cgc_n == 0 && cgc_free >= 0) {
+                cgc_tr_tid[cgc_free] = cgc_tid;
+                cgc_n = ++cgc_tr_cnt[cgc_free];
+                cgc_new = true;
+            }
+        }
+        if (cgc_new || cgc_n <= 3 || (cgc_n % 2048 == 0)) {
+            fprintf(stderr, "CGC-L4-EVICT-TRACE: tid=%llu layer=%u slot=%d evict_no=%llu %s\n",
+                    cgc_tid, layer, slot, cgc_n, cgc_new ? "[NEW THREAD]" : "");
+        }
+    }
     if (slot < 0 || layer >= cache->pool.size()) {
         return;
     }
